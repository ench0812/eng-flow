# ~/.claude/memory-pg/.env — 由 bootstrap.sh 產生；本檔在 ~/.claude 根層之下，被白名單 .gitignore 擋住，不入庫。
# 密碼只用於本機 127.0.0.1 綁定的容器；仍不得複製進任何 repo。
MEMORY_PG_PASSWORD=__GENERATED__
MEMORY_PG_PORT=5433
MEMORY_PG_DSN=postgresql://memory:__GENERATED__@127.0.0.1:5433/memory
MEMORY_PG_TEST_DSN=postgresql://memory:__GENERATED__@127.0.0.1:5433/claude_memory_test
# embedding（Task 3 才用）
OLLAMA_URL=http://127.0.0.1:11434
